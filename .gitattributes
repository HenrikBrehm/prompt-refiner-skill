# Normalize line endings to LF on commit; check out as-is on each platform.
* text=auto eol=lf

# Text formats — always store with LF
*.md          text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.sh          text eol=lf
*.txt         text eol=lf

# Binaries — never normalize
*.png         binary
*.jpg         binary
*.gif         binary
*.ico         binary
